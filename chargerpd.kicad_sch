		(uuid "5fc42721-fe8c-45bf-babc-19a1dfdb8c31")
	)
	(text "U302 LM74700 + Q303 = ideal diode (replaces SS54): blocks battery back-feed into VBUS, ~20 mV drop instead of ~0.4 V. D303 SMAJ12A = VBUS TVS."
		(exclude_from_sim no)
		(at 35.56 20.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "cc3e437a-414d-4d7d-959b-70434d752638")
	)
