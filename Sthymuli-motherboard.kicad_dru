# BEGIN generated by scripts/netclass_rules.py: edit scripts/netclasses.toml, not this block
# Widths: IPC-2221 external, 35 um copper, 20 C rise. Clearance: IPC-2221B B2.
# Later rules win, so the pad exceptions come after the class rules.
# PWR_5A: 5 A, up to 4.2 V
(rule "PWR_5A track width"
  (condition "A.hasNetclass('PWR_5A')")
  (constraint track_width (min 1.85mm) (opt 1.85mm)))
# PWR_3A: 3 A, up to 9 V
(rule "PWR_3A track width"
  (condition "A.hasNetclass('PWR_3A')")
  (constraint track_width (min 0.9mm) (opt 0.9mm)))
# PWR_2A: 2 A, up to 4.2 V
(rule "PWR_2A track width"
  (condition "A.hasNetclass('PWR_2A')")
  (constraint track_width (min 0.55mm) (opt 0.55mm)))
# PWR_5A pads narrower than 1.85 mm: F401, F402, F403, F404
(rule "PWR_5A neck-down to 1.4mm at pads"
  (condition "A.hasNetclass('PWR_5A') && (A.intersectsCourtyard('F401') || A.intersectsCourtyard('F402') || A.intersectsCourtyard('F403') || A.intersectsCourtyard('F404'))")
  (constraint track_width (min 1.4mm) (opt 1.4mm)))
# PWR_5A pads narrower than 1.85 mm: C201, C501, C502, JP102, JP103
(rule "PWR_5A neck-down to 1mm at pads"
  (condition "A.hasNetclass('PWR_5A') && (A.intersectsCourtyard('C201') || A.intersectsCourtyard('C501') || A.intersectsCourtyard('C502') || A.intersectsCourtyard('JP102') || A.intersectsCourtyard('JP103'))")
  (constraint track_width (min 1mm) (opt 1mm)))
# PWR_5A pads narrower than 1.85 mm: C401, C503, C509
(rule "PWR_5A neck-down to 0.9mm at pads"
  (condition "A.hasNetclass('PWR_5A') && (A.intersectsCourtyard('C401') || A.intersectsCourtyard('C503') || A.intersectsCourtyard('C509'))")
  (constraint track_width (min 0.9mm) (opt 0.9mm)))
# PWR_5A pads narrower than 1.85 mm: R401, R403, R503
(rule "PWR_5A neck-down to 0.8mm at pads"
  (condition "A.hasNetclass('PWR_5A') && (A.intersectsCourtyard('R401') || A.intersectsCourtyard('R403') || A.intersectsCourtyard('R503'))")
  (constraint track_width (min 0.8mm) (opt 0.8mm)))
# PWR_5A pads narrower than 1.85 mm: SW101
(rule "PWR_5A neck-down to 0.65mm at pads"
  (condition "A.hasNetclass('PWR_5A') && (A.intersectsCourtyard('SW101'))")
  (constraint track_width (min 0.65mm) (opt 0.65mm)))
# PWR_5A pads narrower than 1.85 mm: U401
(rule "PWR_5A neck-down to 0.6mm at pads"
  (condition "A.hasNetclass('PWR_5A') && (A.intersectsCourtyard('U401'))")
  (constraint track_width (min 0.6mm) (opt 0.6mm)))
# PWR_5A pads narrower than 1.85 mm: FPC101, FPC102, FPC103, FPC104, M401
(rule "PWR_5A neck-down to 0.5mm at pads"
